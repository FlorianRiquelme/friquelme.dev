---
import { Icon } from 'astro-icon/components';
import Badge from '../ui/Badge.astro';
import ButtonPrimary from '../ui/ButtonPrimary.astro';
import ButtonGhost from '../ui/ButtonGhost.astro';
import TerminalWindow from '../content/TerminalWindow.astro';
---

<section class="relative overflow-hidden border-b border-border-primary bg-bg-page px-5 py-12 md:px-16 md:py-20">
  <div class="mx-auto max-w-[1200px]">
    <div class="flex flex-col items-center text-center" data-animate>
      <!-- Badge -->
      <Badge variant="success" label="open source • launching soon" />

      <!-- Headline -->
      <h1 class="mt-6 max-w-[900px] text-4xl font-bold leading-[1.15] text-text-primary md:text-5xl lg:text-[56px]">
        SSH connections that remember where you left off
      </h1>

      <!-- Subheadline -->
      <p class="mt-6 max-w-[700px] text-sm leading-relaxed text-text-secondary md:text-base">
        SSHerpa integrates with 1Password, remembers your last connection per project, and keeps your team's server configs in sync. One command to connect, zero time wasted searching.
      </p>

      <!-- CTAs -->
      <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row stagger-1" data-animate>
        <ButtonPrimary label="brew install ssherpa" icon="lucide:download" />
        <ButtonGhost label="View on GitHub" icon="lucide:github" href="https://github.com/friquelme/ssherpa" />
      </div>

      <!-- Terminal Demo -->
      <div class="mt-12 w-full max-w-[900px] stagger-2" data-animate style="filter: drop-shadow(0 20px 80px rgba(34, 197, 94, 0.06));">
        <TerminalWindow title="~/my-project — ssherpa">
          <div class="flex flex-col gap-1.5">
            <p class="text-[13px] font-medium text-green-primary font-mono">$ ssherpa</p>
            <p class="text-[13px] text-text-tertiary font-mono">Found project context: my-project</p>
            <p class="text-[13px] text-text-tertiary font-mono">Last connection: prod-api-1</p>
            <div class="h-2"></div>
            <p class="text-[13px] text-text-secondary font-mono">? Select server:</p>
            <p class="text-[13px] text-green-primary font-mono">  → prod-api-1 (ubuntu@10.0.1.24)</p>
            <p class="text-[13px] text-text-muted font-mono">    staging-api-1 (ubuntu@10.0.2.12)</p>
            <p class="text-[13px] text-text-muted font-mono">    dev-db-1 (admin@10.0.3.5)</p>
            <div class="h-2"></div>
            <p class="text-[13px] text-text-tertiary font-mono">Connecting to prod-api-1...</p>
            <p class="text-[13px] text-green-primary font-mono">Welcome to Ubuntu 22.04.3 LTS</p>
            <div class="flex items-center">
              <span class="text-[13px] font-medium text-green-primary font-mono">ubuntu@prod-api-1:~$ </span>
              <span class="h-4 w-[9px] bg-green-primary animate-pulse"></span>
            </div>
          </div>
        </TerminalWindow>
      </div>
    </div>
  </div>
</section>
