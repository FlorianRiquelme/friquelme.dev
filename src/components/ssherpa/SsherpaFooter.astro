---
import { Icon } from 'astro-icon/components';
---

<footer class="border-t border-border-primary bg-bg-page px-5 py-12 md:px-16">
  <div class="mx-auto max-w-[1200px]">
    <div class="grid gap-8 md:grid-cols-[1fr_auto]">
      <!-- Logo & Description -->
      <div class="flex flex-col gap-4">
        <span class="text-lg font-medium text-green-primary font-mono">~ssherpa</span>
        <p class="max-w-[400px] text-xs text-text-tertiary">
          Open-source SSH connection manager for developers who value their time.
        </p>
      </div>

      <!-- Links -->
      <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
        <div class="flex flex-col gap-3">
          <h3 class="text-xs font-semibold text-text-secondary font-mono">Product</h3>
          <a href="#features" class="text-xs text-text-muted hover:text-green-primary transition-colors font-mono">
            Features
          </a>
          <a href="#how-it-works" class="text-xs text-text-muted hover:text-green-primary transition-colors font-mono">
            How It Works
          </a>
        </div>

        <div class="flex flex-col gap-3">
          <h3 class="text-xs font-semibold text-text-secondary font-mono">Resources</h3>
          <a href="https://github.com/friquelme/ssherpa#readme" class="text-xs text-text-muted hover:text-green-primary transition-colors font-mono">
            Documentation
          </a>
          <a href="https://github.com/friquelme/ssherpa/releases" class="text-xs text-text-muted hover:text-green-primary transition-colors font-mono">
            Releases
          </a>
        </div>

        <div class="flex flex-col gap-3">
          <h3 class="text-xs font-semibold text-text-secondary font-mono">Community</h3>
          <a href="https://github.com/friquelme/ssherpa" class="text-xs text-text-muted hover:text-green-primary transition-colors font-mono">
            GitHub
          </a>
          <a href="https://github.com/friquelme/ssherpa/blob/main/CONTRIBUTING.md" class="text-xs text-text-muted hover:text-green-primary transition-colors font-mono">
            Contributing
          </a>
        </div>

        <div class="flex flex-col gap-3">
          <h3 class="text-xs font-semibold text-text-secondary font-mono">Legal</h3>
          <a href="https://github.com/friquelme/ssherpa/blob/main/LICENSE" class="text-xs text-text-muted hover:text-green-primary transition-colors font-mono">
            License
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-border-primary">
      <p class="text-xs text-text-muted font-mono">
        © {new Date().getFullYear()} SSHerpa. Open source under MIT License.
      </p>
    </div>
  </div>
</footer>
