---
import Logo from './Logo.astro';
import Divider from '../ui/Divider.astro';

interface Props {
  brandName?: string;
  copyright?: string;
}

const { brandName = 'developer', copyright = `// built by ${brandName} © ${new Date().getFullYear()}` } = Astro.props;
---

<footer class="flex flex-col gap-6 px-5 py-8 md:gap-8 md:px-16 md:py-10">
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
    <Logo name={brandName} />
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <slot name="links" />
    </div>
  </div>
  <Divider />
  <div class="flex items-center justify-between">
    <span class="text-[11px] text-text-muted font-mono">{copyright}</span>
    <span class="text-[11px] text-text-muted font-mono">exit 0</span>
  </div>
</footer>
