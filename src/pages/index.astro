---
import Layout from '../layouts/Layout.astro';

// UI
import ButtonPrimary from '../components/ui/ButtonPrimary.astro';
import ButtonSecondary from '../components/ui/ButtonSecondary.astro';
import StatusIndicator from '../components/ui/StatusIndicator.astro';
import Divider from '../components/ui/Divider.astro';

// Nav
import Logo from '../components/nav/Logo.astro';
import NavItem from '../components/nav/NavItem.astro';
import HeaderBar from '../components/nav/HeaderBar.astro';
import Footer from '../components/nav/Footer.astro';

// Content
import SectionHeader from '../components/content/SectionHeader.astro';
import TerminalWindow from '../components/content/TerminalWindow.astro';
import ProjectCard from '../components/content/ProjectCard.astro';

import { featured, groups, projects } from '../data/projects';
---

<Layout
  title="Florian Riquelme · Software Engineer"
  description="Senior software engineer at SVO Netz GmbH in Celle. Production software for a regional utility, and open-source tools for working with coding agents."
  image={new URL('/og/index.png', Astro.site).href}
>
  <!-- Header -->
  <HeaderBar>
    <Logo name="friquelme.dev" slot="logo" />
    <Fragment slot="nav">
      <NavItem label="about" href="#about" active />
      <NavItem label="projects" href="#projects" />
      <NavItem label="blog" href="/blog/" />
      <NavItem label="contact" href="#contact" />
    </Fragment>
    <StatusIndicator text="building things" slot="status" />
  </HeaderBar>

  <!-- Hero Section -->
  <section id="about" class="flex flex-col items-center gap-8 bg-bg-page px-5 pt-20 pb-16 md:gap-10 md:px-16 md:pt-[120px] md:pb-[100px]">
    <div class="w-full max-w-[900px]">
      <TerminalWindow title="~/friquelme.dev">
        <div id="hero-terminal">
          <p data-type="cmd" class="text-sm font-medium text-green-primary terminal-hidden">$ whoami</p>
          <p data-type="out" class="text-sm text-text-primary terminal-hidden">florian riquelme: senior software engineer</p>
          <div data-type="out" class="h-3 terminal-hidden"></div>
          <p data-type="cmd" class="text-sm font-medium text-green-primary terminal-hidden">$ cat intro.txt</p>
          <p data-type="out" class="text-sm text-text-secondary terminal-hidden">9+ years shipping saas platforms, e-commerce, and web apps.</p>
          <p data-type="out" class="text-sm text-text-secondary terminal-hidden">i build open-source tools for working with coding agents.</p>
          <p data-type="out" class="text-sm text-text-secondary terminal-hidden">full-stack across the board, react frontends to aws infrastructure.</p>
          <p data-type="out" class="text-sm text-text-secondary terminal-hidden">currently at svo netz gmbh, turning team prototypes into production software for a regional utility.</p>
          <div data-type="out" class="h-3 terminal-hidden"></div>
          <p data-type="cmd" class="text-sm font-medium text-green-primary terminal-hidden">$ echo $current_stack</p>
          <p data-type="out" class="text-sm text-text-primary terminal-hidden">php · react · typescript · go · swift</p>
          <div data-type="out" class="h-3 terminal-hidden"></div>
          <p data-type="cmd" class="text-sm font-medium text-green-primary terminal-hidden">$ echo $experience</p>
          <p data-type="out" class="text-sm text-text-primary terminal-hidden">9+ years of experience</p>
          <div data-type="out" class="h-4 terminal-hidden"></div>
          <div id="hero-cursor" class="flex items-center terminal-hidden">
            <span class="text-sm font-medium text-green-primary">$ </span>
            <span class="h-[18px] w-[9px] bg-green-primary animate-blink"></span>
          </div>
        </div>
      </TerminalWindow>
    </div>

    <!-- Hero Bottom -->
    <div id="hero-bottom" class="flex flex-col items-center gap-8 w-full max-w-[900px] opacity-0 transition-opacity duration-700">
      <div class="sr-only">
        <p id="profile-summary">Florian Riquelme is a senior software engineer based in Celle, Germany. Since October 2026 he works at SVO Netz GmbH, part of SVO-Gruppe, a regional energy and infrastructure provider (power, gas, water, fiber). As the first new hire in a growing team for internal software development, he builds, reviews and operates the group's own software, turns prototypes colleagues built at team offsites into tools they rely on every day, and looks after the group's Statamic-based customer websites svo.de and svo-netz.de. He has 9+ years shipping SaaS platforms, e-commerce, and web applications, works full-stack across PHP, React, TypeScript, Go, Swift, and AWS, and maintains open-source tools for working with coding agents, including screengrab, nachtschicht, claudefuel, and ddev-claude.</p>
      </div>
      {/* H1 stays brand-voice; SEO keywords ride on the <title> tag and Person schema. */}
      <h1 class="text-2xl font-semibold text-text-primary text-center md:text-4xl">
        i build software, and the tools i build it with.
      </h1>
      <p class="text-sm text-text-tertiary text-center">
        // senior software engineer · full-stack · agent tooling
      </p>
      <div class="flex flex-col items-center gap-3 w-full sm:flex-row sm:gap-4 sm:w-auto">
        <ButtonPrimary label="read_blog" icon="lucide:file-text" href="/blog/" />
        <ButtonSecondary label="github_profile" icon="lucide:github" href="https://github.com/FlorianRiquelme" />
      </div>
    </div>
  </section>

  <Divider />

  <!-- Projects Section -->
  <section id="projects" class="flex flex-col gap-8 bg-bg-page px-5 py-12 md:gap-12 md:px-16 md:py-20">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
      <SectionHeader
        command="$ ls -la ~/projects"
        description="// open-source tooling for working with ai agents"
      />
      <span class="text-xs text-text-muted">{projects.length} repos</span>
    </div>
    <div data-animate class="stagger-1">
      <ProjectCard
        title={featured.title}
        description={featured.description}
        link={featured.repo}
        postLink={featured.postLink}
        tags={featured.tags}
        version={featured.version}
        install={featured.install}
      />
    </div>
    {groups.map((group) => (
      <div class="flex flex-col gap-4">
        <p class="text-[13px] text-text-tertiary font-mono">// {group.caption}</p>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          {group.projects.map((project, i) => (
            <div data-animate class={`stagger-${(i % 3) + 1}`}>
              <ProjectCard
                title={project.title}
                description={project.description}
                link={project.repo}
                postLink={project.postLink}
                tags={project.tags}
              />
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <Divider />

  <!-- Contact Section -->
  <section id="contact" class="flex flex-col items-center gap-8 bg-bg-page px-5 py-12 md:gap-12 md:px-16 md:py-20">
    <div class="flex flex-col items-center gap-2">
      <h2 class="text-xl font-semibold text-green-primary md:text-[28px]">$ ping friquelme.dev</h2>
      <p class="text-[13px] text-text-tertiary text-center">
        // open to open-source collabs, side projects, and dev conversations
      </p>
    </div>

    <div id="contact-terminal-wrapper" class="w-full max-w-[700px]">
      <TerminalWindow title="~/contact">
        <div id="contact-terminal">
          <p data-type="cmd" class="text-[13px] font-medium text-green-primary terminal-hidden">$ cat contact_info.json</p>
          <p data-type="out" class="text-[13px] text-text-muted whitespace-pre-wrap terminal-hidden">{"{"}</p>
          <p data-type="out" class="text-[13px] text-text-secondary whitespace-pre-wrap break-all terminal-hidden">  "email":    "flo@friquelme.dev",</p>
          <p data-type="out" class="text-[13px] text-text-secondary whitespace-pre-wrap break-all terminal-hidden">  "github":   "github.com/FlorianRiquelme",</p>
          <p data-type="out" class="text-[13px] text-text-secondary whitespace-pre-wrap break-all terminal-hidden">  "linkedin": "linkedin.com/in/florian-riquelme-b97756143",</p>
          <p data-type="out" class="text-[13px] text-text-secondary whitespace-pre-wrap break-all terminal-hidden">  "location": "celle, germany"</p>
          <p data-type="out" class="text-[13px] text-text-muted whitespace-pre-wrap terminal-hidden">{"}"}</p>
          <div data-type="out" class="h-2 terminal-hidden"></div>
          <div id="contact-cursor" class="flex items-center terminal-hidden">
            <span class="text-[13px] font-medium text-green-primary">$ </span>
            <span class="h-4 w-[9px] bg-green-primary animate-blink"></span>
          </div>
        </div>
      </TerminalWindow>
    </div>

    <ButtonPrimary label="send_message" icon="lucide:mail" href="mailto:flo@friquelme.dev" />
  </section>

  <Divider />

  <!-- Footer -->
  <Footer brandName="friquelme.dev" copyright="// designed & built by florian riquelme © 2026">
    <Fragment slot="links">
      <a href="https://github.com/FlorianRiquelme" class="text-xs text-text-tertiary hover:text-text-secondary transition-colors">github</a>
      <a href="https://www.linkedin.com/in/florian-riquelme-b97756143" class="text-xs text-text-tertiary hover:text-text-secondary transition-colors">linkedin</a>
      <a href="https://github.com/FlorianRiquelme/friquelme.dev" class="text-xs text-text-tertiary hover:text-green-primary transition-colors">view source</a>
    </Fragment>
  </Footer>

  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function sleep(ms: number) {
      return new Promise((r) => setTimeout(r, ms));
    }

    async function typeText(el: HTMLElement) {
      const text = el.textContent || '';
      el.textContent = '';
      el.classList.remove('terminal-hidden');
      for (const char of text) {
        el.textContent += char;
        await sleep(40);
      }
    }

    async function runTerminalSequence(containerId: string, cursorId: string) {
      const lines = document.querySelectorAll<HTMLElement>(`#${containerId} [data-type]`);
      const cursor = document.getElementById(cursorId);

      for (const line of lines) {
        if (line.dataset.type === 'cmd') {
          await typeText(line);
          await sleep(200);
        } else {
          line.classList.replace('terminal-hidden', 'terminal-reveal');
          await sleep(50);
        }
      }
      cursor?.classList.remove('terminal-hidden');
    }

    function showTerminalAll(containerId: string, cursorId: string) {
      document.querySelectorAll<HTMLElement>(`#${containerId} [data-type]`)
        .forEach((el) => el.classList.remove('terminal-hidden'));
      document.getElementById(cursorId)?.classList.remove('terminal-hidden');
    }

    // Hero terminal: runs immediately on load
    const heroBottom = document.getElementById('hero-bottom');

    // Reveal hero-bottom immediately so the H1 (LCP element) doesn't wait
    // for the terminal typing sequence. The 700ms CSS transition still gives
    // a soft fade-in.
    if (heroBottom) heroBottom.style.opacity = '1';

    if (reduced) {
      showTerminalAll('hero-terminal', 'hero-cursor');
      showTerminalAll('contact-terminal', 'contact-cursor');
    } else {
      runTerminalSequence('hero-terminal', 'hero-cursor');

      // Contact terminal: triggered on scroll
      const contactWrapper = document.getElementById('contact-terminal-wrapper');
      if (contactWrapper) {
        const contactObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              contactObserver.unobserve(entry.target);
              runTerminalSequence('contact-terminal', 'contact-cursor');
            });
          },
          { threshold: 0.3 }
        );
        contactObserver.observe(contactWrapper);
      }
    }
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "name": "friquelme.dev",
        "url": "https://friquelme.dev",
        "inLanguage": "en"
      },
      {
        "@type": "Person",
        "@id": "https://friquelme.dev/#person",
        "name": "Florian Riquelme",
        "url": "https://friquelme.dev",
        "jobTitle": "Senior Software Engineer",
        "description": "Senior software engineer at SVO Netz GmbH. Builds production software for a regional utility and open-source tools for working with coding agents. 9+ years across SaaS, e-commerce, and web platforms.",
        "image": "https://friquelme.dev/og/index.png",
        "email": "mailto:flo@friquelme.dev",
        "worksFor": {
          "@type": "Organization",
          "name": "SVO Netz GmbH",
          "url": "https://www.svo-netz.de",
          "parentOrganization": {
            "@type": "Organization",
            "name": "SVO-Gruppe",
            "url": "https://www.svo.de"
          }
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Celle",
          "addressCountry": "DE"
        },
        "sameAs": [
          "https://github.com/FlorianRiquelme",
          "https://www.linkedin.com/in/florian-riquelme-b97756143"
        ],
        "knowsAbout": ["PHP", "React", "TypeScript", "Go", "Swift", "AWS", "LLM Integration", "Coding Agents"]
      },
      {
        "@type": "ProfilePage",
        "@id": "https://friquelme.dev/#profile",
        "url": "https://friquelme.dev",
        "mainEntity": { "@id": "https://friquelme.dev/#person" },
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": ["#profile-summary"]
        }
      },
      ...projects.map((project) => ({
        "@type": "SoftwareSourceCode",
        "name": project.title,
        "description": project.description,
        "codeRepository": project.repo,
        "programmingLanguage": project.language,
        "author": { "@id": "https://friquelme.dev/#person" },
        "keywords": project.tags.join(", ")
      }))
    ]
  })} />
</Layout>
