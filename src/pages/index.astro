---
import '@fontsource-variable/manrope/index.css';
import Layout from '../layouts/Layout.astro';

import HeaderBar from '../components/nav/HeaderBar.astro';
import Logo from '../components/nav/Logo.astro';
import NavItem from '../components/nav/NavItem.astro';
import StatusIndicator from '../components/ui/StatusIndicator.astro';
import Footer from '../components/nav/Footer.astro';
import Divider from '../components/ui/Divider.astro';
import Workshop from '../components/workshop/Workshop.astro';
import ProjectIndex from '../components/workshop/ProjectIndex.astro';

import { projects } from '../data/projects';
---

<Layout
  title="Florian Riquelme · Software Engineer"
  description="Senior software engineer at SVO Netz GmbH in Celle. Production software for a regional utility, and open-source tools for working with coding agents. Explore the impossible workshop."
  image={new URL('/og/index.png', Astro.site).href}
>
  <HeaderBar>
    <Logo name="friquelme.dev" slot="logo" />
    <Fragment slot="nav">
      <NavItem label="about" href="#about" active />
      <NavItem label="projects" href="#projects" />
      <NavItem label="blog" href="/blog/" />
      <NavItem label="contact" href="#contact" />
    </Fragment>
    <StatusIndicator text="building things" slot="status" />
  </HeaderBar>

  <section id="about" class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow"><span class="lime" aria-hidden="true">/</span> florian riquelme · independent workshop</p>
        <h1 class="hero-title">software,<br /> with the walls off.</h1>
        <p id="profile-summary" class="hero-profile">
          I am a senior software engineer at SVO Netz GmbH in Celle. I build production software for a regional utility and open-source tools for working with coding agents.
        </p>
        <dl class="hero-facts">
          <div>
            <dt>experience</dt>
            <dd>9+ years / SaaS, e-commerce and web apps</dd>
          </div>
          <div>
            <dt>stack</dt>
            <dd>PHP, React, TypeScript, Go, Swift and AWS</dd>
          </div>
        </dl>
        <div class="hero-actions">
          <a class="action action-primary" data-workshop-enter href="#workshop">
            enter the workshop
            <span aria-hidden="true">↗</span>
          </a>
          <a class="action action-secondary" href="/blog/">read the blog</a>
          <a class="action action-quiet" href="https://github.com/FlorianRiquelme">github</a>
        </div>
      </div>

      <Workshop />
    </div>
  </section>

  <Divider />

  <ProjectIndex />

  <Divider />

  <section id="contact" class="contact">
    <div class="contact-copy">
      <p class="eyebrow">contact / signal</p>
      <h2>start a conversation.</h2>
      <p>
        Open to open-source collaborations, side projects and dev conversations. The quickest route is email. The repositories are open if you want to read the work first.
      </p>
      <a class="action action-primary contact-send" href="mailto:flo@friquelme.dev">send_message</a>
    </div>
    <div class="contact-links">
      <a class="contact-link" href="mailto:flo@friquelme.dev">
        <span class="contact-label">email</span>
        <span class="contact-value">flo@friquelme.dev</span>
        <span class="contact-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="contact-link" href="https://github.com/FlorianRiquelme">
        <span class="contact-label">github</span>
        <span class="contact-value">github.com/FlorianRiquelme</span>
        <span class="contact-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="contact-link" href="https://www.linkedin.com/in/florian-riquelme-b97756143">
        <span class="contact-label">linkedin</span>
        <span class="contact-value">linkedin.com/in/florian-riquelme-b97756143</span>
        <span class="contact-arrow" aria-hidden="true">↗</span>
      </a>
      <p class="contact-location"><span class="contact-label">location</span> <span class="contact-value">celle, germany</span></p>
    </div>
  </section>

  <Divider />

  <Footer brandName="friquelme.dev" copyright="// designed & built by florian riquelme © 2026">
    <Fragment slot="links">
      <a href="https://github.com/FlorianRiquelme" class="text-xs text-text-tertiary hover:text-text-secondary transition-colors">github</a>
      <a href="https://www.linkedin.com/in/florian-riquelme-b97756143" class="text-xs text-text-tertiary hover:text-text-secondary transition-colors">linkedin</a>
      <a href="https://github.com/FlorianRiquelme/friquelme.dev" class="text-xs text-text-tertiary hover:text-green-primary transition-colors">view source</a>
    </Fragment>
  </Footer>

  <script>
    import { mountWorkshop } from '../lib/workshop/mount';

    const workshop = document.querySelector<HTMLElement>('[data-workshop]');
    if (workshop) {
      let mounted = false;
      let leaving = false;
      const start = () => {
        if (mounted || leaving) return;
        mounted = true;
        void mountWorkshop({ root: workshop });
      };
      window.addEventListener('pagehide', () => { leaving = true; });
      window.addEventListener('pageshow', event => {
        leaving = false;
        if (event.persisted && workshop.dataset.workshopState !== 'ready') {
          mounted = false;
          start();
        }
      });
      for (const enter of document.querySelectorAll<HTMLElement>('[data-workshop-enter]')) {
        enter.addEventListener('click', () => {
          if (workshop.dataset.workshopState !== 'ready') workshop.dataset.workshopEnterPending = 'room:screengrab';
        });
      }
      const scheduleStart = () => {
        const idle = window.requestIdleCallback?.bind(window);
        if (idle) idle(start, { timeout: 1500 });
        else window.setTimeout(start, 100);
      };
      if (typeof window.IntersectionObserver === 'function') {
        const observer = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          scheduleStart();
        }, { threshold: 0.01 });
        observer.observe(workshop);
      } else {
        window.setTimeout(scheduleStart, 200);
      }
    }
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "name": "friquelme.dev",
        "url": "https://friquelme.dev",
        "inLanguage": "en"
      },
      {
        "@type": "Person",
        "@id": "https://friquelme.dev/#person",
        "name": "Florian Riquelme",
        "url": "https://friquelme.dev",
        "jobTitle": "Senior Software Engineer",
        "description": "Senior software engineer at SVO Netz GmbH. Builds production software for a regional utility and open-source tools for working with coding agents. 9+ years across SaaS, e-commerce, and web platforms.",
        "image": "https://friquelme.dev/og/index.png",
        "email": "mailto:flo@friquelme.dev",
        "worksFor": {
          "@type": "Organization",
          "name": "SVO Netz GmbH",
          "url": "https://www.svo-netz.de",
          "parentOrganization": {
            "@type": "Organization",
            "name": "SVO-Gruppe",
            "url": "https://www.svo.de"
          }
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Celle",
          "addressCountry": "DE"
        },
        "sameAs": [
          "https://github.com/FlorianRiquelme",
          "https://www.linkedin.com/in/florian-riquelme-b97756143"
        ],
        "knowsAbout": ["PHP", "React", "TypeScript", "Go", "Swift", "AWS", "LLM Integration", "Coding Agents"]
      },
      {
        "@type": "ProfilePage",
        "@id": "https://friquelme.dev/#profile",
        "url": "https://friquelme.dev",
        "mainEntity": { "@id": "https://friquelme.dev/#person" },
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": ["#profile-summary"]
        }
      },
      ...projects.map((project) => ({
        "@type": "SoftwareSourceCode",
        "name": project.title,
        "description": project.description,
        "codeRepository": project.repo,
        "programmingLanguage": project.language,
        "author": { "@id": "https://friquelme.dev/#person" },
        "keywords": project.tags.join(", ")
      }))
    ]
  })} />
</Layout>
