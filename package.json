{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:build": "pnpm build && pnpm test:dist",
    "test:mutation": "stryker run",
    "test:infra": "pnpm -C infra test",
    "test:dist": "vitest run --config vitest.build.config.ts",
    "test:browser": "pnpm build && e2e run",
    "test:browser:smoke": "pnpm build && e2e run --target desktop-chromium",
    "verify": "node scripts/verify.mjs",
    "verify:reports": "node --test --test-reporter=tap tests/verification/report-outcomes.test.mjs",
    "verify:controls": "node scripts/negative-controls.mjs",
    "verify:infra": "node scripts/verify.mjs --infra"
  },
  "dependencies": {
